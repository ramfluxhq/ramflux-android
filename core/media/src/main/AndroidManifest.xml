<!--
  Media3 declares a wake-lock permission for screen-off playback. This app plays only app-private files in
  the foreground and never sets a wake mode, so it is removed from the merged manifest. The network-state
  permission is kept: the delivery page reads the data saver setting with it, and Firebase messaging expects
  it. The permission guard does not count removal markers.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
</manifest>
