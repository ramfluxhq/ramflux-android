<resources>
    <string name="marked_unread">Marked unread</string>
    <!-- Accessibility label of the round information button next to a section or header. -->
    <string name="kit_info_label">More information</string>
    <string name="time_unavailable">Time unavailable</string>
    <string name="unread_count">%1$s unread</string>
    <plurals name="unread_messages">
        <item quantity="one">%1$s unread message</item>
        <item quantity="other">%1$s unread messages</item>
    </plurals>
    <!-- Short marker shown next to the name of a person the SDK verified as an AI agent. Keep it to two or three characters. -->
