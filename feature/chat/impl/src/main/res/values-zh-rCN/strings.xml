    <string name="chat_media_open_body">%1$s 将交给此设备上的其他应用。Ramflux 之外的副本之后不会被删除。</string>
    <!-- Confirm button of the open confirmation. -->
    <string name="chat_media_open">打开</string>
    <!-- Notice after an image was saved to the photo library. -->
    <string name="chat_media_saved">已保存到相册</string>
