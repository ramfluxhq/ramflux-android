    <string name="chat_viewer_video_failed">此设备无法播放此视频。</string>
    <!-- Elapsed and total video time; %1$s and %2$s are media times in Western digits, shown left to right. -->
    <string name="chat_viewer_time">%1$s / %2$s</string>
