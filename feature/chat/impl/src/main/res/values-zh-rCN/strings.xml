    <plurals name="chat_media_album">
        <item quantity="other">相册，%1$d 项</item>
    </plurals>
    <!-- Viewer button that starts the video. -->
    <string name="chat_viewer_play">播放</string>
    <!-- Viewer button that pauses the video. -->
    <string name="chat_viewer_pause">暂停</string>
