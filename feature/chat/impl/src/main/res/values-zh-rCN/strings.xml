    <string name="chat_forward_unavailable">此处无法转发。</string>
    <!-- Accessibility label of the button that closes the forward chooser. -->
    <string name="chat_forward_close">关闭</string>
    <!-- Shown when a picked video is longer than the 10-minute cap for compressed video. -->
    <string name="chat_media_video_too_long">此视频超过 10 分钟，请改为以文件发送。</string>
    <!-- Shown when a compressed video is still larger than the 200 MB cap. -->
    <string name="chat_media_video_too_large">压缩后此视频仍超过 200 MB，请改为以文件发送。</string>
    <!-- Shown when a media send is refused because the group has more than 64 recipient devices. -->
    <string name="chat_media_recipient_limit">暂不支持向超过 64 台设备的群组发送媒体。</string>
