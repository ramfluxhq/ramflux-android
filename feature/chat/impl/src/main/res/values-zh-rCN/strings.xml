    <string name="chat_media_peer_upgrade">对方需要更新 Ramflux 才能接收媒体。</string>
    <!-- Shown when the attachment is too large for the relay quota or the device storage. -->
    <string name="chat_media_too_large">附件过大或存储空间已满。</string>
