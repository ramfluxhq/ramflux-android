    <string name="chat_not_sent">未发送</string>
    <!-- Action next to "Not sent" that sends the same message again. -->
    <string name="chat_retry">重试</string>
    <!-- Message action that removes an unsent local message from this device. -->
    <string name="chat_discard">丢弃</string>
    <!-- Status inside an own bubble that waits for a connection before it is sent. -->
    <string name="chat_queued">待发送</string>
    <!-- Status inside an own bubble that is being handed to the SDK. -->
    <string name="chat_sending">发送中</string>
    <!-- Notice above the timeline while messages wait for the connection to return. -->
    <string name="chat_offline_notice">当前离线 · 消息将在恢复连接后发送</string>
    <!-- Header action that opens the conversation details. -->
    <string name="chat_conversation_details">会话详情</string>
    <!-- Header action that starts a one-to-one call. -->
    <string name="chat_call">通话</string>
    <!-- Row at the top of the timeline while an older page loads. -->
    <string name="chat_loading_older">正在加载更早的消息</string>
    <!-- Accessibility label of one quick reaction; %1$s is the emoji, shown as is. -->
    <string name="chat_react_with">用 %1$s 回应</string>
    <!-- One reaction with its count; %1$s is the reaction emoji, %2$d the number of people. -->
    <string name="chat_reaction_count">%1$s %2$d</string>
    <!-- Separator between short status words under a message, as in "Not sent · Retry". -->
    <string name="chat_meta_separator">·</string>
    <!-- Problem shown when a picked photo or file could not be prepared for sending. -->
    <string name="chat_media_not_staged">所选内容无法准备发送。</string>
    <!-- Status inside a media bubble that is not on this device yet; tapping downloads it. -->
    <string name="chat_media_download">点按下载</string>
    <!-- Status inside a media bubble while it downloads; the SDK reports no byte progress. -->
    <string name="chat_media_loading">正在下载…</string>
    <!-- Status inside a media bubble whose download failed; tapping retries. -->
    <string name="chat_media_failed">下载失败 · 点按重试</string>
    <!-- Status of an attachment whose 24-hour access window has passed. -->
    <string name="chat_media_expired">已不可用</string>
    <!-- Status of an attachment the sender removed. -->
    <string name="chat_media_revoked">发送者已移除</string>
    <!-- Status of an attachment this device holds no key for (paired after it was sent). -->
    <string name="chat_media_not_on_device">此设备无法查看</string>
    <!-- Status of an attachment from an untrusted sender; nothing is shown until tapped. -->
    <string name="chat_media_hidden">点按显示</string>
    <!-- Status inside an own media bubble while it is prepared and uploaded. -->
    <string name="chat_media_sending">正在发送…</string>
