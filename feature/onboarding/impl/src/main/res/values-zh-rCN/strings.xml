    <!-- Label of the six-digit account code field. -->
    <string name="ui_account_code">账户码</string>
    <!-- Explains the account code on the unlock and create screens. -->
    <string name="ui_account_code_explanation">六位数字。它与本机的安全存储一起在此处打开你的账户数据。它不是恢复短语。</string>
    <!-- Label of the code field when a new account code is chosen. -->
    <string name="ui_choose_account_code">设置六位账户码</string>
    <!-- Refusal: the code is not six digits. -->
    <string name="ui_code_not_six_digits">账户码必须正好是 6 位数字。</string>
    <!-- Refusal: the new code is on the trivial list. -->
    <string name="ui_code_trivial">这个账户码太容易被猜到（重复数字或连续数字），请换一个。</string>
    <!-- Refusal: a wrong account code was entered. -->
    <string name="ui_code_wrong">这个账户码无法打开账户。多次输错后需要等待才能再次尝试。</string>
    <!-- Refusal: no more code attempts are allowed. -->
    <string name="ui_code_attempts_exhausted">输错次数过多。请用恢复短语恢复账户。</string>
    <!-- Refusal: the device unlock secret is missing. -->
    <string name="ui_code_device_unlock_unavailable">本机安全存储中没有此账户的解锁密钥。请用恢复短语恢复账户。</string>
