    <string name="backup_passphrase">Archive passphrase</string>
    <!-- Rule for the archive passphrase; it is not the account code. -->
    <string name="backup_passphrase_help">The archive has its own passphrase: at least 15 characters and not a common password. It is not your six-digit account code.</string>
    <!-- Button that writes the backup. -->
    <string name="backup_create_confirm">Start backup</string>
    <!-- Shown while an archive is copied or checked. -->
    <string name="backup_working">Working…</string>
