    <string name="ui_created_network_connecting">Connecting to the network…</string>
    <!-- Account created step: the SDK reports the new account's network session as live. -->
    <string name="ui_created_network_connected">Connected to the network</string>
    <!-- Account created step: the network session did not become live while the step was shown. -->
    <string name="ui_created_network_not_confirmed">The network connection is not confirmed yet. The account works on this phone; messages go out once it connects.</string>
