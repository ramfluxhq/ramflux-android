    <string name="backup_verify_help">Enter the archive\'s passphrase to check it before anything is restored.</string>
    <!-- Button that checks the archive. -->
    <string name="backup_verify">Check archive</string>
    <!-- Caption under the archive's account name. -->
    <string name="backup_archive_account">Account in this archive</string>
