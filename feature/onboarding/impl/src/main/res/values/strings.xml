    <string name="backup_state_writing">Writing</string>
    <!-- Job state: checking the archive. -->
    <string name="backup_state_verifying">Checking</string>
    <!-- Job state: checked, ready to install. -->
    <string name="backup_state_verified">Checked</string>
    <!-- Job state: installing. -->
    <string name="backup_state_installing">Restoring</string>
    <!-- Job state: finished. -->
    <string name="backup_state_done">Finished</string>
    <!-- Job state: failed. -->
    <string name="backup_state_failed">Failed</string>
    <!-- Job state: cancelled. -->
    <string name="backup_state_cancelled">Cancelled</string>
