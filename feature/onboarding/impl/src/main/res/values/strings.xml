    <string name="backup_new_account_help">This restores the account as a new account on this phone. Set the six-digit code that will open it here.</string>
    <!-- Label of the new account code. -->
    <string name="backup_new_code">New account code</string>
    <!-- Button that restores as a new account. -->
    <string name="backup_install_new">Restore account</string>
