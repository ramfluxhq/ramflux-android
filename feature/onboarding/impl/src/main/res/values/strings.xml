    <string name="backup_progress">%1$d%% · %2$s</string>
    <!-- Progress without a total; %1$s is the SDK's current step name. -->
    <string name="backup_progress_open">In progress · %1$s</string>
    <!-- Button that cancels a job. -->
    <string name="backup_cancel">Cancel</string>
    <!-- Button that saves a finished archive with the system file picker. -->
    <string name="backup_save">Save file</string>
    <!-- Shown after the archive was saved and removed from private storage. -->
    <string name="backup_saved">Saved. The copy in app storage was removed.</string>
    <!-- The core cannot run backup jobs here. -->
    <string name="backup_unavailable">Backup is not available here.</string>
    <!-- Backup needs an open account. -->
    <string name="backup_account_needed">Open an account to back it up.</string>
    <!-- Refusal: the archive passphrase is too short or common. -->
    <string name="backup_weak_passphrase">Use at least 15 characters that are not a common password.</string>
    <!-- Refusal: the archive passphrase is wrong. -->
    <string name="backup_wrong_passphrase">The passphrase does not open this archive.</string>
    <!-- Refusal: the archive is above the import limit. -->
    <string name="backup_too_large">This file is larger than 256 MiB and cannot be restored on a phone.</string>
    <!-- Refusal: the new account code is too easy. -->
    <string name="backup_code_refused">Choose six digits that are not all the same or a straight run.</string>
    <!-- Refusal: the account must be unlocked. -->
    <string name="backup_account_locked">Unlock the account first.</string>
    <!-- The outcome is not known. -->
    <string name="backup_unknown">The result is not known yet. Check the job list.</string>
    <!-- Generic backup failure. -->
    <string name="backup_failed">The backup step did not succeed.</string>
    <!-- Code page heading: %1$s is the display name of the account being unlocked. -->
    <string name="ui_unlock_account_named">Unlock %1$s</string>
    <!-- Button after the SDK refused an account offered from this phone's list for a reason other than the code; it removes only the offer, never account data. -->
    <string name="ui_forget_account_on_device">Remove from the list on this phone</string>
