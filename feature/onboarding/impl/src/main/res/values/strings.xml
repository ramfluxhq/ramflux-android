    <string name="backup_merge_help">This account is already on this phone. Restoring merges the archive into it; newer local data is kept.</string>
    <!-- Button that asks to merge. -->
    <string name="backup_merge">Merge into this account</string>
    <!-- Host confirmation title before merging. -->
    <string name="backup_merge_confirm_title">Merge the archive?</string>
    <!-- Host confirmation body before merging. -->
    <string name="backup_merge_confirm_body">The account is paused while the archive is merged.</string>
    <!-- Button that confirms the merge. -->
    <string name="backup_merge_confirm">Merge</string>
