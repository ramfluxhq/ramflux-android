    <!-- Label of the six-digit account code field. -->
    <string name="ui_account_code">Account code</string>
    <!-- Explains the account code on the unlock and create screens. -->
    <string name="ui_account_code_explanation">Six digits. Together with this phone\'s secure storage it opens your account data here. It is not your recovery phrase.</string>
    <!-- Label of the code field when a new account code is chosen. -->
    <string name="ui_choose_account_code">Choose a six-digit account code</string>
    <!-- Refusal: the code is not six digits. -->
    <string name="ui_code_not_six_digits">The account code must be exactly 6 digits.</string>
    <!-- Refusal: the new code is on the trivial list. -->
    <string name="ui_code_trivial">This code is too easy to guess (repeated digits or a straight run). Choose another.</string>
    <!-- Refusal: a wrong account code was entered. -->
    <string name="ui_code_wrong">That code did not open the account. After several wrong codes you have to wait before the next try.</string>
    <!-- Refusal: no more code attempts are allowed. -->
    <string name="ui_code_attempts_exhausted">Too many wrong codes. Recover the account with its recovery phrase.</string>
    <!-- Refusal: the device unlock secret is missing. -->
    <string name="ui_code_device_unlock_unavailable">This phone\'s secure storage holds no unlock key for this account. Recover the account with its recovery phrase.</string>
    <!-- Shown when the phrase check is submitted incomplete. -->
    <string name="ui_enter_the_recovery_words_and_the_account_code">Enter the three recovery words and a six-digit account code.</string>
