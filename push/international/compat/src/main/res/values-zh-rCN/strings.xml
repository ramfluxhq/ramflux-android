    <!-- Vendor settings steps: what the person is asked to switch on. -->
    <string name="compat_samsung_sleeping_title">不要让 Ramflux 进入休眠应用</string>
    <string name="compat_samsung_sleeping_body">在“设置”中打开“电池”，再打开“后台使用限制”。确保 Ramflux 不在“休眠应用”或“深度休眠应用”中，并把它加入“永不休眠的应用”。</string>
    <string name="compat_xiaomi_autostart_title">允许自启动</string>
    <string name="compat_xiaomi_autostart_body">为 Ramflux 打开“自启动”，这样收到消息或来电时它可以在后台启动。</string>
    <string name="compat_xiaomi_permissions_title">允许锁屏显示和后台弹出界面</string>
    <string name="compat_xiaomi_permissions_body">在应用的“其他权限”中，允许“锁屏显示”“后台弹出界面”和“后台启动”。同时为“消息”和“来电”打开锁屏通知和悬浮通知。</string>
    <string name="compat_xiaomi_battery_title">取消省电限制</string>
    <string name="compat_xiaomi_battery_body">把 Ramflux 的省电策略设为“无限制”。</string>
    <string name="compat_lock_recents_title">在最近任务中锁定 Ramflux</string>
    <string name="compat_lock_recents_body">打开最近任务界面并锁定 Ramflux 卡片（长按卡片，或使用锁形图标），这样清理任务列表时不会停止它。</string>
    <string name="compat_huawei_app_launch_title">手动管理应用启动</string>
    <string name="compat_huawei_app_launch_body">打开“应用启动管理”，把 Ramflux 切换为“手动管理”，然后打开“自启动”“关联启动”和“后台活动”。</string>
    <string name="compat_honor_app_launch_title">手动管理应用启动</string>
    <string name="compat_honor_app_launch_body">打开“应用启动管理”，把 Ramflux 切换为“手动管理”，然后打开“自启动”“关联启动”和“后台活动”。</string>
    <string name="compat_oplus_auto_launch_title">允许自动启动</string>
    <string name="compat_oplus_auto_launch_body">为 Ramflux 打开“自动启动”，这样收到消息或来电时它可以在后台启动。</string>
    <string name="compat_oplus_background_title">允许后台活动</string>
    <string name="compat_oplus_background_body">在应用的“耗电管理”页面中，允许“后台活动”“自动启动”和“前台活动”。</string>
    <string name="compat_vivo_background_start_title">允许后台启动</string>
    <string name="compat_vivo_background_start_body">为 Ramflux 打开“自启动”（后台启动）。</string>
    <string name="compat_vivo_high_power_title">允许后台高耗电</string>
    <string name="compat_vivo_high_power_body">在“后台耗电管理”中，允许 Ramflux 后台高耗电运行。</string>
    <string name="compat_sony_stamina_title">检查“STAMINA 模式”</string>
    <string name="compat_sony_stamina_body">如果开启了 STAMINA 模式，请在可选时把 Ramflux 排除在外，或在等待来电时关闭该模式。</string>
    <string name="compat_transsion_autostart_title">允许自启动</string>
    <string name="compat_transsion_autostart_body">在“手机管家”中，为 Ramflux 允许“自启动”。</string>
    <string name="compat_transsion_power_title">不要对 Ramflux 进行省电限制</string>
    <string name="compat_transsion_power_body">在“手机管家”中，把 Ramflux 从应用省电和后台限制中排除。</string>
    <string name="compat_asus_autostart_title">允许自启动</string>
    <string name="compat_asus_autostart_body">在“手机管理”中，于“自启动管理”里允许 Ramflux。</string>
</resources>
