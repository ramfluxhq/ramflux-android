<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets an incoming-call notification take over a locked screen (API 34+ makes it a special access the person can revoke). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Reads the data saver setting for the delivery page (ConnectivityManager.getRestrictBackgroundStatus). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Package visibility (Android 11+): the standard settings screens SafeSettingsLauncher resolves before it starts them. -->
    <application>
        <!-- The full-screen target of the test ring: shows over the lock screen and holds only the test line. -->
        <activity
            android:name="org.ramflux.push.selftest.RingTestActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />
    </application>
    <queries>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.BATTERY_SAVER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.CHANNEL_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APP_USE_FULL_SCREEN_INTENT" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BACKGROUND_DATA_RESTRICTIONS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.AUTO_REVOKE_PERMISSIONS" />
            <data android:scheme="package" />
        </intent>
    </queries>
</manifest>
