# Copy to scripts/realrun.local.env (untracked) and replace the placeholders. One KEY=value per line;
# quotes are optional, a leading ~/ is expanded, no other shell syntax is evaluated. An environment
# variable of the same name overrides the file. See docs/realrun.md.

# Always: the node under test and the rf binary that drives the alice and bob peers.
RAMFLUX_REALRUN_NODE_DIR=<absolute-path-of-the-node-directory>
RAMFLUX_REALRUN_RF=<absolute-path-of-the-rf-binary>

# Target phone: the machine whose adb reaches the phone ("local" or an SSH host name), its adb, the
# device serial and a scratch directory there. Not needed for --target emulator.
RAMFLUX_REALRUN_HOST=<adb-host>
RAMFLUX_REALRUN_ADB=<adb-path-on-that-host>
RAMFLUX_REALRUN_SERIAL=<device-serial>
RAMFLUX_REALRUN_REMOTE_DIR=<scratch-directory-on-that-host>

# Optional.
# RAMFLUX_REALRUN_ENV=<shell-file-to-source-first>
# RAMFLUX_REALRUN_PYTHON=python3
# RAMFLUX_REALRUN_GATEWAY_CONTAINER=<gateway-container-name>   # enables the clock-skew check
# RAMFLUX_REALRUN_CONTAINER_ENGINE=podman
# RAMFLUX_REALRUN_TAP_DELAY=2.5
